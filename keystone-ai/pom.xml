<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.keystone</groupId>
        <artifactId>keystone-root</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>keystone-ai</artifactId>
    <packaging>jar</packaging>
    <description>Keystone AI 模块 - Spring AI 多模型集成、对话、RAG</description>

    <dependencies>
        <!-- 内部依赖 -->
        <dependency>
            <groupId>com.keystone</groupId>
            <artifactId>keystone-framework</artifactId>
        </dependency>

        <!-- Spring AI - OpenAI (兼容 OpenAI / 国产大模型 API) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Spring AI - Ollama (本地模型) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns-native-macos</artifactId>
            <classifier>osx-aarch_64</classifier>
        </dependency>
    </dependencies>

</project>
